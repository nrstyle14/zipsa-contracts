# ZIPSA 환경변수 템플릿
#
# 사용법: cp .env.example .env 후 값을 채운다. `.env` 는 gitignore 처리돼 있다.
# 이 파일에는 **값을 절대 넣지 말 것** — 키 이름과 설명만 둔다.
#
# forge 는 .env 를 자동으로 읽는다. vitest 는 읽지 않으므로 실행 전에 셸로 읽힌다:
#   set -a; source .env; set +a
# RPC 는 foundry.toml 의 giwa_sepolia 별칭(공개 엔드포인트)을 쓴다 — 키가 필요 없다.

# ─── 개인키 ──────────────────────────────────────────────────────────────────
# 전부 GIWA Sepolia 전용 데모 키다. 실자산이 있는 키를 넣지 말 것.

# 배포자 — Deploy·DeployErc7710·DemoRedeem 이 읽는다. 컨트랙트 배포·tKRW 민팅(MINTER_ROLE).
PRIVATE_KEY=

# 주인 EOA — 도장 보유 + 7702 코드 심긴 주소. 위임 서명·철회에 쓴다.
# DemoRedeem 과 packages/delegation 의 roundtrip 테스트가 읽는다 (없으면 테스트는 skip).
OWNER_PRIVATE_KEY=

# 에이전트 — 결제 리딤을 브로드캐스트한다. DemoRedeem 이 읽는다.
AGENT_PRIVATE_KEY=

# ─── 주소 (선택) ─────────────────────────────────────────────────────────────
# 이미 배포된 스택을 재사용할 때만 (DeployErc7710 이 읽는다).
# TOKEN_ADDRESS 를 넘기면 초기 발행을 건너뛴다.
TOKEN_ADDRESS=
GATE_ADDRESS=
REGISTRY_ADDRESS=

# ─── 로컬 포크 (선택) ────────────────────────────────────────────────────────
# packages/delegation 의 roundtrip 테스트용. 비우면 http://127.0.0.1:8545 를 쓴다.
#   anvil --fork-url https://sepolia-rpc-flashblocks.giwa.io --port 8545
ANVIL_RPC_URL=
